{
  "name": "ghost-ink-road",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode poki && node scripts/check-build.mjs dist/poki poki",
    "build:poki": "npm run build",
    "build:web": "tsc --noEmit && vite build --mode web && node scripts/check-build.mjs dist/web web",
    "build:single": "npm run build:web && node scripts/build-single.mjs dist/web dist/single/GhostInkRoad_PhoneTest_v1.html",
    "preview": "vite preview --outDir dist/poki",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/core.test.ts",
    "levelcheck": "node --experimental-strip-types tools/levelcheck.ts",
    "tune": "node --experimental-strip-types tools/tune.ts",
    "sfx": "python3 tools/make_sfx.py",
    "cheapest": "node --experimental-strip-types tools/cheapest.ts",
    "levelmap": "node --experimental-strip-types --no-warnings tools/levelmap.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@fontsource/nunito": "5.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
